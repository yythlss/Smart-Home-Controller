.title {
  margin-bottom: 18rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.host-row {
  display: grid;
  grid-template-columns: 1fr 160rpx;
  gap: 16rpx;
  margin-top: 12rpx;
}

.host-input {
  height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 12rpx;
  background: #ffffff;
}

button {
  margin: 0;
  border-radius: 12rpx;
  font-size: 26rpx;
}

button::after {
  border: none;
}

.primary {
  color: #ffffff;
  background: #2563eb;
}

.secondary {
  margin-top: 20rpx;
  color: #1f2937;
  background: #e5e7eb;
}

.secondary.inline {
  margin-top: 0;
}

.message {
  min-height: 36rpx;
  margin-top: 18rpx;
  color: #475467;
  font-size: 24rpx;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.metric {
  padding: 18rpx 10rpx;
  border-radius: 12rpx;
  background: #f2f4f7;
  text-align: center;
}

.metric-value {
  font-size: 32rpx;
  font-weight: 700;
}

.metric-label {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
}

.info-list {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.info-row {
  display: grid;
  grid-template-columns: 150rpx 1fr;
  gap: 14rpx;
  padding: 8rpx 0;
  color: #344054;
  font-size: 24rpx;
}

.info-label {
  color: #667085;
}

.manual-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.manual-field {
  min-width: 0;
}

.manual-input {
  box-sizing: border-box;
  width: 100%;
  height: 74rpx;
  margin-top: 8rpx;
  padding: 0 16rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 26rpx;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.preset-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 16rpx;
}

.preset {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  color: #075985;
  background: #e0f2fe;
}

.mode-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.mode,
.level {
  color: #344054;
  background: #eef2f6;
}

.mode.active,
.level.active {
  color: #ffffff;
  background: #16a34a;
}

.device-row {
  display: grid;
  grid-template-columns: 100rpx 1fr;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.device-name {
  font-weight: 600;
}

.level-buttons {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.level {
  height: 66rpx;
  line-height: 66rpx;
  padding: 0;
}

.sample-row {
  display: grid;
  grid-template-columns: 44rpx 1fr 64rpx;
  align-items: center;
  gap: 12rpx;
  margin: 12rpx 0;
}

.sample-index,
.sample-score {
  color: #667085;
  font-size: 22rpx;
  text-align: right;
}

.bar-track {
  height: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.bar-fill {
  height: 18rpx;
  border-radius: 999rpx;
  background: #14b8a6;
}
