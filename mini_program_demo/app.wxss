page {
  background: #f6f7fb;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.panel {
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(31, 41, 55, 0.08);
}

.row {
  display: flex;
  align-items: center;
}

.muted {
  color: #667085;
}
