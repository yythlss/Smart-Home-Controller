<view class="home-header">
  <view>
    <view class="home-title">我的空气管家</view>
    <view class="home-subtitle">舒适、安全、自动运行</view>
  </view>
  <view class="connection-chip {{connected ? 'online' : 'offline'}}">
    <text class="status-dot"></text>{{connected ? '设备在线' : '设备离线'}}
  </view>
</view>

<view wx:if="{{message}}" class="home-message">{{message}}</view>

<view wx:if="{{!configured}}" class="empty-home">
  <view class="empty-icon">⌂</view>
  <view class="empty-title">还没有连接家庭设备</view>
  <view class="empty-text">请从页面最底部进入操作后台，配置 ESP32 局域网地址。</view>
</view>

<block wx:if="{{state}}">
  <view wx:if="{{state.alarm_active}}" class="alarm-banner">
    <view>
      <view class="alarm-title">环境告警</view>
      <view class="alarm-reason">{{state.alarm_reason}}</view>
    </view>
    <button class="alarm-button" bindtap="acknowledgeAlarm">确认</button>
  </view>
</block>

<view class="panel hero-panel" wx:if="{{state}}">
  <view class="hero-topline">
    <view>
      <view class="section-eyebrow">当前环境</view>
      <view class="comfort-text">{{state.comfort || '正在分析'}}</view>
    </view>
    <view class="source-chip">{{state.sourceText}}</view>
  </view>
  <view class="metrics">
    <view class="metric temperature">
      <view class="metric-value">{{state.has_temperature ? state.temperature_c : '--'}}<text class="metric-unit">°C</text></view>
      <view class="metric-label">室内温度</view>
    </view>
    <view class="metric humidity">
      <view class="metric-value">{{state.has_humidity ? state.humidity_percent : '--'}}<text class="metric-unit">%</text></view>
      <view class="metric-label">空气湿度</view>
    </view>
    <view class="metric air">
      <view class="metric-value">{{state.air_score}}</view>
      <view class="metric-label">空气评分 · {{state.air_state}}</view>
    </view>
  </view>
  <view class="advice-card">
    <text class="advice-label">家居建议</text>
    <text>{{state.advice || '环境状态良好'}}</text>
  </view>
</view>

<view class="panel" wx:if="{{state}}">
  <view class="section-head">
    <view>
      <view class="section-title">快捷场景</view>
      <view class="section-caption">当前：{{state.activeSceneText}}</view>
    </view>
  </view>
  <view class="scene-grid">
    <button wx:for="{{scenes}}" wx:key="key"
      class="{{state.active_scene === item.value ? 'scene active' : 'scene'}}"
      data-scene="{{item.key}}" bindtap="setScene">{{item.name}}</button>
  </view>
</view>

<view class="panel" wx:if="{{state}}">
  <view class="section-head">
    <view>
      <view class="section-title">家居设备</view>
      <view class="section-caption">按需控制或交给自动模式</view>
    </view>
    <view class="mode-actions">
      <button class="{{state.auto_mode ? 'mode-pill active' : 'mode-pill'}}" data-mode="auto" bindtap="setMode">自动</button>
      <button class="{{state.eco_mode ? 'mode-pill active eco' : 'mode-pill'}}" data-mode="eco" bindtap="setMode">节能</button>
    </view>
  </view>
  <view class="light-row">
    <view>
      <view class="device-title">照明</view>
      <view class="device-subtitle">{{state.light_on ? '灯光已开启' : '灯光已关闭'}}</view>
    </view>
    <switch color="#16a34a" checked="{{state.light_on}}" bindchange="toggleLight" />
  </view>
  <block wx:for="{{devices}}" wx:key="key">
    <view class="device-row">
      <view class="device-info">
        <view class="device-title">{{item.name}}</view>
        <view class="device-subtitle">{{item.level === 0 ? '已关闭' : item.level + ' 档运行'}}<text wx:if="{{item.override > 0}}" class="override-mark"> · 手动控制中</text></view>
      </view>
      <view class="level-buttons">
        <button wx:for="{{levels}}" wx:for-item="level" wx:key="*this"
          class="{{item.level === level ? 'level active' : 'level'}}"
          data-device="{{item.key}}" data-level="{{level}}" bindtap="setDevice">{{level}}</button>
      </view>
    </view>
  </block>
</view>

<view class="panel" wx:if="{{state}}">
  <view class="section-head">
    <view>
      <view class="section-title">空间感知</view>
      <view class="section-caption">{{state.occupied ? '家中有人' : '当前无人'}} · {{state.radar_target_count || 0}} 个目标</view>
    </view>
  </view>
  <view class="radar-map">
    <view class="radar-zone zone-left">左</view>
    <view class="radar-zone zone-center">中</view>
    <view class="radar-zone zone-right">右</view>
    <view class="radar-axis vertical"></view>
    <view class="radar-axis horizontal"></view>
    <view class="radar-device">设备</view>
    <view wx:if="{{radar.visible}}" class="radar-target" style="left: {{radar.left}}%; top: {{radar.top}}%;"></view>
  </view>
  <view class="radar-label">{{radar.label}}</view>
</view>

<view class="panel" wx:if="{{state}}">
  <view class="section-head">
    <view>
      <view class="section-title">环境趋势</view>
      <view class="section-caption">最近 30 个采样点</view>
    </view>
  </view>
  <view class="chart-legend">
    <view><text class="legend-dot air-dot"></text>空气</view>
    <view><text class="legend-dot temp-dot"></text>温度</view>
    <view><text class="legend-dot humidity-dot"></text>湿度</view>
  </view>
  <canvas type="2d" id="trendCanvas" class="trend-canvas"></canvas>
</view>

<view class="main-footer" bindtap="openAdmin">设备配置、调试与操作后台</view>
