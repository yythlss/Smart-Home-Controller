page {
  padding-bottom: 36rpx;
  background: #f4f7f6;
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 30rpx 18rpx;
}

.home-title {
  color: #172033;
  font-size: 42rpx;
  font-weight: 700;
}

.home-subtitle {
  margin-top: 6rpx;
  color: #7b8495;
  font-size: 22rpx;
}

.connection-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
}

.connection-chip.online {
  color: #166534;
  background: #dcfce7;
}

.connection-chip.offline {
  color: #64748b;
  background: #e2e8f0;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.home-message {
  margin: 0 24rpx 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  color: #475569;
  background: #ffffff;
  font-size: 22rpx;
  text-align: center;
}

.empty-home {
  margin: 80rpx 36rpx 320rpx;
  padding: 70rpx 38rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
}

.empty-icon {
  color: #94a3b8;
  font-size: 76rpx;
}

.empty-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 14rpx;
  color: #7b8495;
  font-size: 23rpx;
  line-height: 1.7;
}

.panel {
  margin-top: 18rpx;
}

.hero-panel {
  overflow: hidden;
  background: linear-gradient(145deg, #ffffff, #f0fdfa);
}

.hero-topline,
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-eyebrow,
.section-caption {
  color: #7b8495;
  font-size: 21rpx;
}

.comfort-text {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.source-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #0f766e;
  background: #ccfbf1;
  font-size: 20rpx;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.metric {
  padding: 24rpx 8rpx;
  border-radius: 16rpx;
  text-align: center;
}

.metric.temperature {
  background: #fff7ed;
}

.metric.humidity {
  background: #eff6ff;
}

.metric.air {
  background: #ecfdf5;
}

.metric-value {
  color: #172033;
  font-size: 36rpx;
  font-weight: 700;
}

.metric-unit {
  margin-left: 3rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.metric-label {
  margin-top: 6rpx;
  color: #667085;
  font-size: 20rpx;
}

.advice-card {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  color: #344054;
  background: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
}

.advice-label {
  flex: 0 0 auto;
  color: #0f766e;
  font-weight: 600;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.section-caption {
  margin-top: 5rpx;
}

button {
  margin: 0;
  border-radius: 12rpx;
  font-size: 24rpx;
}

button::after {
  border: none;
}

.scene-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10rpx;
  margin-top: 22rpx;
}

.scene {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  color: #475569;
  background: #f1f5f9;
  font-size: 22rpx;
}

.scene.active {
  color: #ffffff;
  background: #0f766e;
}

.mode-actions {
  display: flex;
  gap: 8rpx;
}

.mode-pill {
  min-width: 88rpx;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 14rpx;
  color: #64748b;
  background: #f1f5f9;
  font-size: 21rpx;
}

.mode-pill.active {
  color: #ffffff;
  background: #16a34a;
}

.mode-pill.active.eco {
  background: #0f766e;
}

.light-row,
.device-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.light-row {
  margin-top: 14rpx;
}

.device-row:last-child {
  border-bottom: none;
}

.device-info {
  flex: 0 0 170rpx;
}

.device-title {
  font-size: 26rpx;
  font-weight: 600;
}

.device-subtitle {
  margin-top: 5rpx;
  color: #8a93a3;
  font-size: 20rpx;
}

.override-mark {
  color: #d97706;
}

.level-buttons {
  display: grid;
  flex: 1;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}

.level {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0;
  color: #64748b;
  background: #f1f5f9;
}

.level.active {
  color: #ffffff;
  background: #16a34a;
}

.radar-map {
  position: relative;
  height: 330rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border: 1rpx solid #dbe3ea;
  border-radius: 18rpx;
  background: radial-gradient(circle at 50% 100%, #dbeafe 0, #eff6ff 36%, #f8fafc 70%);
}

.radar-zone {
  position: absolute;
  top: 16rpx;
  color: #94a3b8;
  font-size: 20rpx;
}

.zone-left { left: 16%; }
.zone-center { left: 48%; }
.zone-right { right: 16%; }

.radar-axis {
  position: absolute;
  background: rgba(148, 163, 184, 0.4);
}

.radar-axis.vertical {
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1rpx;
}

.radar-axis.horizontal {
  right: 0;
  bottom: 50%;
  left: 0;
  height: 1rpx;
}

.radar-device {
  position: absolute;
  bottom: 9rpx;
  left: 50%;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #334155;
  font-size: 18rpx;
  transform: translateX(-50%);
}

.radar-target {
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  border: 7rpx solid rgba(239, 68, 68, 0.22);
  border-radius: 50%;
  background: #ef4444;
  box-shadow: 0 0 24rpx rgba(239, 68, 68, 0.68);
  transform: translate(-50%, -50%);
}

.radar-label {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 21rpx;
  text-align: center;
}

.chart-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 18rpx;
  color: #64748b;
  font-size: 21rpx;
}

.legend-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  margin-right: 7rpx;
  border-radius: 50%;
}

.air-dot { background: #14b8a6; }
.temp-dot { background: #f97316; }
.humidity-dot { background: #3b82f6; }

.trend-canvas {
  width: 100%;
  height: 330rpx;
  margin-top: 12rpx;
}

.alarm-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 18rpx 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #dc2626, #f97316);
}

.alarm-title {
  font-size: 27rpx;
  font-weight: 700;
}

.alarm-reason {
  margin-top: 5rpx;
  font-size: 20rpx;
}

.alarm-button {
  color: #b91c1c;
  background: #ffffff;
}

.main-footer {
  margin: 42rpx 0 8rpx;
  color: #a5acb8;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  text-align: center;
}
